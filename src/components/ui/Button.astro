---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}
const { href, variant = 'primary', class: className = '' } = Astro.props;
const external = href.startsWith('http');
---

<a
  href={href}
  {...external ? { rel: 'noopener' } : {}}
  class:list={[
    'inline-flex items-center justify-center rounded-full px-7 py-4 text-sm font-bold tracking-wide transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand',
    variant === 'primary' ? 'bg-brand text-brand-ink hover:bg-brand/90' : 'border border-ink/15 bg-surface text-ink hover:bg-ink/5',
    className,
  ]}
>
  <slot />
</a>
