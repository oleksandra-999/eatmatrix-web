---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { framerImages, type FramerImageKey } from '../../assets/framer/manifest';

interface Props {
  name: FramerImageKey;
  alt: string;
  class?: string;
  /** Rendered width in CSS px at the largest breakpoint; used to size the optimized image. */
  width?: number;
  loading?: 'lazy' | 'eager';
}

const { name, alt, class: className = '', width, loading = 'lazy' } = Astro.props;
const meta = framerImages[name];
const local = import.meta.glob<{ default: ImageMetadata }>('../../assets/framer/*.{png,jpg,jpeg,webp}', { eager: true });
const src = local[`../../assets/framer/${meta.file}`]?.default;
const renderWidth = Math.min(width ?? meta.width, meta.width);
---

{
  src ? (
    <Image src={src} alt={alt} width={renderWidth} densities={[1, 2]} loading={loading} class={className} />
  ) : (
    <div
      role="img"
      aria-label={alt}
      class:list={['flex items-center justify-center rounded-2xl border-2 border-dashed border-todo/40 bg-todo-soft text-center text-xs text-todo', className]}
      style={`aspect-ratio: ${meta.width} / ${meta.height}`}
      data-placeholder={meta.file}
    >
      <span class="px-3">Image pending: {name}</span>
    </div>
  )
}
