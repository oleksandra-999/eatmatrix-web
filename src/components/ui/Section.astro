---
interface Props {
  id?: string;
  class?: string;
  inner?: string;
}
const { id, class: className = '', inner = '' } = Astro.props;
---

<section id={id} class:list={['px-4 py-16 sm:px-6 md:py-24', className]}>
  <div class:list={['mx-auto max-w-6xl', inner]}>
    <slot />
  </div>
</section>
