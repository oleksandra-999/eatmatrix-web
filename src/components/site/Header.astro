---
import { localizePath, type Lang } from '../../i18n';
import { site } from '../../i18n/site';
import { links } from '../../i18n/links';
import Icon from '../ui/Icon.astro';
interface Props {
  lang?: Lang;
  /** Where "Get started" goes: the pricing block on the landing page, the App Store elsewhere. */
  ctaHref?: string;
}
const { lang = 'en', ctaHref = links.appStore } = Astro.props;
const t = site[lang];
---

<header class="sticky top-0 z-30 px-4 pt-4">
  <div class="mx-auto flex h-16 max-w-[430px] items-center justify-between rounded-3xl bg-white px-4 shadow-[0_2px_10px_rgba(0,0,0,0.06)] lg:h-[72px] lg:max-w-6xl lg:px-8">
    <a href={localizePath('/', lang)} aria-label={t.homeLabel} class="block h-10 w-[90px] text-ink">
      <Icon name="logo" viewBox="0 0 90 40" class="h-full w-full" />
    </a>
    <nav class="hidden items-center gap-8 text-[15px] font-semibold text-ink/80 md:flex" aria-label="Site">
      <a href="/articles" class="hover:text-purple">{t.articles}</a>
      <a href="/additives" class="hover:text-purple">{t.additives}</a>
      <a href="/independence" class="hover:text-purple">{t.independence}</a>
    </nav>
    <div class="flex items-center gap-3">
      <a href="/articles" class="text-[14px] font-semibold text-ink/80 md:hidden">{t.articles}</a>
      <a href={ctaHref} class="rounded-full bg-lavender px-5 py-2.5 text-[15px] font-semibold text-purple">{t.getStarted}</a>
    </div>
  </div>
</header>
