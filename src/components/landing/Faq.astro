---
import type { LandingCopy } from '../../i18n/landing';
interface Props { t: LandingCopy }
const { t } = Astro.props;
---

<section class="pt-20 lg:mx-auto lg:max-w-3xl lg:pt-32">
  <h2 class="text-center text-[30px] leading-tight font-semibold lg:text-[44px]">{t.faq.title}</h2>
  <div class="mt-8 space-y-3 lg:mt-12">
    {
      t.faq.items.map((item) => (
        <details class="group rounded-[24px] border border-line/60 bg-white px-5 py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[16px] font-semibold">
            {item.q}
            <span class="text-muted transition group-open:rotate-180" aria-hidden="true">⌄</span>
          </summary>
          <p class="mt-3 text-[14px] leading-relaxed text-ink/80">{item.a}</p>
        </details>
      ))
    }
  </div>
</section>
