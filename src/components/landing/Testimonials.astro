---
import type { LandingCopy } from '../../i18n/landing';
import FramerImage from '../ui/FramerImage.astro';
import Icon from '../ui/Icon.astro';
import Rich from '../ui/Rich.astro';
interface Props { t: LandingCopy }
const { t } = Astro.props;
const r = t.testimonials;
---

<section class="pt-24 text-center lg:pt-36">
  <h2 class="text-[30px] leading-tight font-semibold lg:text-[44px]">{r.titleLine1}<br /><Rich text={r.titleLine2} /></h2>
  <p class="mt-4 text-[18px] leading-snug text-muted lg:text-[20px]">{r.subtitle}</p>
  <div class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 [scrollbar-width:none] lg:mt-12 lg:grid lg:grid-cols-3 lg:gap-8 lg:overflow-visible">
    {
      r.items.map((item) => (
        <figure class="w-[88%] shrink-0 snap-center rounded-[32px] bg-white p-4 text-left shadow-[0_2px_16px_rgba(0,0,0,0.05)] lg:w-auto">
          <FramerImage name={item.image} alt="" width={340} class="w-full rounded-[24px]" />
          <figcaption class="mt-4">
            <span class="inline-flex items-center gap-2 rounded-full bg-pink px-3 py-1.5 text-[12px] font-bold tracking-[0.04em] text-red uppercase">
              <Icon name="found" viewBox="0 0 16 16" class="h-3.5 w-3.5" />
              {item.found}
            </span>
            <p class="mt-3 text-[16px] leading-snug">{item.quote}</p>
            <p class="mt-2 text-[14px] text-muted">{item.name}</p>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
