---
import type { LandingCopy } from '../../i18n/landing';
import { localizePath, type Lang } from '../../i18n';
import Icon from '../ui/Icon.astro';
interface Props { t: LandingCopy; lang: Lang }
const { t, lang } = Astro.props;
// The live page also links Articles, Additives and Independence here; they come back as those pages get built.
---

<header class="sticky top-0 z-30 px-4 pt-4">
  <div class="mx-auto flex h-16 max-w-[430px] items-center justify-between rounded-3xl bg-white px-4 shadow-[0_2px_10px_rgba(0,0,0,0.06)] lg:h-[72px] lg:max-w-6xl lg:px-8">
    <a href={localizePath('/', lang)} aria-label={t.nav.homeLabel} class="block h-10 w-[90px] text-ink">
      <Icon name="logo" viewBox="0 0 90 40" class="h-full w-full" />
    </a>
    <a href={t.nav.ctaHref} class="rounded-full bg-lavender px-5 py-2.5 text-[15px] font-semibold text-purple">{t.nav.cta}</a>
  </div>
</header>
