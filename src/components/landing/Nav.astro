---
import type { LandingCopy } from '../../i18n/landing';
import { localizePath, type Lang } from '../../i18n';
import Button from '../ui/Button.astro';
interface Props { t: LandingCopy; lang: Lang }
const { t, lang } = Astro.props;
---

<header class="sticky top-0 z-20 border-b border-line/60 bg-page/85 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6" aria-label="Main">
    <a href={localizePath('/', lang)} class="text-xl font-extrabold tracking-tight">EatMatrix</a>
    <Button href={t.nav.ctaHref} class="px-5! py-2.5!">{t.nav.cta}</Button>
  </nav>
</header>
