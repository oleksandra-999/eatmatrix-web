---
import type { LandingCopy } from '../../i18n/landing';
import { getArticles } from '../../lib/articles';
import ArticleCard from '../articles/ArticleCard.astro';
import Rich from '../ui/Rich.astro';
interface Props { t: LandingCopy }
const { t } = Astro.props;
const featured = (await getArticles()).filter((a) => a.data.featured).slice(0, 3);
---

{
  featured.length > 0 && (
    <section class="pt-24 text-center lg:pt-36">
      <h2 class="text-[30px] leading-tight font-semibold lg:text-[44px]"><Rich text={t.researchDesk.title} /></h2>
      <p class="mx-auto mt-4 text-[18px] leading-snug text-muted lg:max-w-2xl lg:text-[20px]">{t.researchDesk.subtitle}</p>
      <div class="mt-8 grid gap-4 text-left lg:mt-12 lg:grid-cols-3 lg:gap-8">
        {featured.map((article) => <ArticleCard article={article} showDate={false} />)}
      </div>
      <a href="/articles" class="mt-6 inline-flex items-center gap-2 rounded-full bg-lavender px-6 py-3 text-[15px] font-semibold text-purple">{t.researchDesk.all}</a>
    </section>
  )
}
