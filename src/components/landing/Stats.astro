---
import type { LandingCopy } from '../../i18n/landing';
interface Props { t: LandingCopy }
const { t } = Astro.props;
---

<section class="border-y border-line bg-surface px-4 py-8 sm:px-6" aria-label="At a glance">
  <dl class="mx-auto grid max-w-5xl grid-cols-2 gap-6 text-center md:grid-cols-4">
    {
      t.stats.map((s) => (
        <div class="flex flex-col items-center justify-center">
          <dt class="order-2 text-xs font-semibold tracking-widest text-muted">{s.label}</dt>
          <dd class="order-1 text-2xl font-extrabold tracking-tight sm:text-3xl">{s.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
