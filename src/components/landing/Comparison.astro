---
import type { LandingCopy } from '../../i18n/landing';
import FramerImage from '../ui/FramerImage.astro';
import Icon from '../ui/Icon.astro';
import Rich from '../ui/Rich.astro';
import Cta from '../ui/Cta.astro';
interface Props { t: LandingCopy }
const { t } = Astro.props;
const c = t.comparison;
---

<section class="pt-24 text-center lg:pt-36">
  <h2 class="text-[30px] leading-tight font-semibold lg:text-[44px]"><Rich text={c.title} /></h2>
  <div class="lg:mt-12 lg:grid lg:grid-cols-2 lg:gap-8">
    <div class="mt-8 rounded-[32px] bg-pink p-5 pb-8 text-left lg:mt-0 lg:p-8">
      <div class="relative overflow-hidden rounded-[24px]">
        <FramerImage name="comparisonSkincare" alt="" width={480} class="w-full" />
        <span class="absolute inset-x-0 top-6 text-center text-[14px] font-bold tracking-[0.12em] text-white uppercase drop-shadow">{c.skincare.title}</span>
      </div>
      <ul class="mt-5 space-y-3 text-[16px] text-ink/80">
        {
          c.skincare.points.map((point) => (
            <li class="flex items-center gap-3">
              <Icon name="cross" viewBox="0 0 24 24" class="h-6 w-6 shrink-0" />
              {point}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="-mt-4 rounded-[32px] bg-white p-5 text-left shadow-[0_8px_30px_rgba(0,0,0,0.08)] lg:mt-0 lg:p-8">
      <div class="relative overflow-hidden rounded-[24px]">
        <FramerImage name="comparisonApp" alt="" width={480} class="w-full" />
        <span class="absolute inset-x-0 top-5 text-center text-[14px] font-bold tracking-[0.12em] text-purple uppercase">{c.app.title}</span>
      </div>
      <ul class="mt-5 space-y-3 text-[16px] text-ink/80">
        {
          c.app.points.map((point) => (
            <li class="flex items-center gap-3">
              <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full border border-lavender-line bg-lavender-soft text-purple">
                <Icon name="check" viewBox="0 0 20 20" class="h-3.5 w-3.5" />
              </span>
              {point}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="relative mt-8 overflow-hidden rounded-[40px] lg:mt-10">
    <FramerImage name="benefits" alt="" width={1088} class="aspect-[1576/2304] w-full object-cover lg:aspect-[16/8] lg:object-[50%_30%]" />
    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/50 to-transparent p-6 pt-24 text-white lg:flex lg:items-end lg:justify-between lg:gap-12 lg:p-12 lg:text-left">
      <p class="serif text-[40px] leading-[1.05] lg:max-w-2xl lg:text-[56px]">{c.closing}</p>
      <div class="lg:w-80 lg:shrink-0 lg:text-center">
        <p class="mt-6 text-[15px] text-white/90 lg:mt-0">{c.reassurance}</p>
        <Cta href={c.ctaHref} variant="yellow" class="mt-3">{c.cta}</Cta>
      </div>
    </div>
  </div>
</section>
