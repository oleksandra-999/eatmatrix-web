---
import type { LandingCopy } from '../../i18n/landing';
import Button from '../ui/Button.astro';
import Section from '../ui/Section.astro';
interface Props { t: LandingCopy }
const { t } = Astro.props;
const c = t.comparison;
---

<Section class="bg-surface">
  <p class="text-center text-sm font-bold tracking-widest text-brand uppercase">{c.eyebrow}</p>
  <div class="mt-8 grid gap-6 md:grid-cols-2">
    <div class="rounded-3xl border border-line p-8">
      <h3 class="text-2xl font-bold text-muted">{c.skincare.title}</h3>
      <ul class="mt-6 space-y-4">
        {
          c.skincare.points.map((p) => (
            <li class="flex gap-3">
              <span aria-hidden="true" class="font-bold text-risk">✕</span>
              <span>{p}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="rounded-3xl bg-brand p-8 text-brand-ink">
      <h3 class="text-2xl font-bold">{c.app.title}</h3>
      <ul class="mt-6 space-y-4">
        {
          c.app.points.map((p) => (
            <li class="flex gap-3">
              <span aria-hidden="true" class="font-bold">✓</span>
              <span class="font-semibold">{p}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="mt-12 flex flex-col items-center gap-4 text-center">
    <p class="max-w-2xl text-2xl font-bold text-balance">{c.closing}</p>
    <Button href={c.ctaHref}>{c.cta}</Button>
    <p class="text-sm text-muted">{c.reassurance}</p>
  </div>
</Section>
