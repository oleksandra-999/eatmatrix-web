---
import type { LandingCopy } from '../../i18n/landing';
import FramerImage from '../ui/FramerImage.astro';
import Rich from '../ui/Rich.astro';
import Cta from '../ui/Cta.astro';
interface Props { t: LandingCopy }
const { t } = Astro.props;
const s = t.howItWorks;
---

<section class="pt-24 text-center lg:pt-36">
  <h2 class="text-[30px] leading-tight font-semibold lg:text-[44px]">{s.title}</h2>
  <p class="mt-4 text-[18px] leading-snug text-muted lg:text-[20px]">{s.subtitleLines[0]}<br />{s.subtitleLines[1]}</p>
  <div class="mt-8 rounded-[32px] bg-white p-5 shadow-[0_2px_16px_rgba(0,0,0,0.05)] lg:mt-12 lg:p-10">
    <div class="lg:grid lg:grid-cols-3 lg:gap-8">
      {
        s.steps.map((step) => (
          <div class="mb-8 last:mb-0 lg:mb-0">
            <div class="relative overflow-hidden rounded-[24px]">
              <FramerImage name={step.image} alt="" width={340} class="w-full" />
              <span class="absolute top-5 left-5 inline-flex items-center gap-3 text-[18px] font-semibold">
                <span class="rounded-full bg-ink px-4 py-2 text-white">{step.label}</span>
                {step.title}
              </span>
            </div>
            <p class="mt-4 text-[14px] leading-snug text-muted"><Rich text={step.body} /></p>
          </div>
        ))
      }
    </div>
    <div class="lg:mx-auto lg:mt-10 lg:max-w-2xl">
      <p class="serif mt-8 rounded-[24px] bg-grey px-6 py-5 text-[20px] leading-snug lg:mt-0 lg:text-[24px]">{s.closing}</p>
      <Cta href={s.ctaHref} variant="yellow" class="mt-4">{s.cta}</Cta>
    </div>
  </div>
</section>
